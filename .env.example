# Copy to .env.local for development. In production these are set in the Vercel
# project settings — never committed. See claude/TECH_ARCHITECTURE.md.
#
# None of these carry the NEXT_PUBLIC_ prefix, so Next.js keeps them on the
# server. Do not add it to any of them: RESEND_API_KEY would be inlined into
# the browser bundle and readable by every visitor.

# ── Website form delivery (Resend) ───────────────────────────────────────────
# Server-side only. Used by /api/contact and /api/quote via lib/email.ts.

# Resend API key, from https://resend.com/api-keys — a sending key is enough.
# Never put the real key in this file: it is committed. It belongs in
# .env.local, which is gitignored.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Sender identity. Must be on the skinternationals.in domain verified in
# Resend, or the send is refused before it is attempted. A display name is
# optional; the mailbox does not need to be able to receive mail, because
# replies go to the customer via Reply-To.
FORM_FROM_EMAIL="SK Internationals Website <website@skinternationals.in>"

# The three desks that receive every submission from both forms. All three get
# the same email, and all three must be different addresses.
FORM_RECIPIENT_1=sk@skinternationals.in
FORM_RECIPIENT_2=ramki@skinternationals.in
FORM_RECIPIENT_3=saravanakumaar@skinternationals.in

# ── Site ─────────────────────────────────────────────────────────────────────
# Absolute origin for canonicals, Open Graph, and the sitemap. Set per
# environment so preview deploys do not emit production canonicals.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
